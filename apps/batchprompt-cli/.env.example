BATCHPROMPT_OPENAI_API_KEY=your-openai-compatible-key
BATCHPROMPT_OPENAI_BASE_URL=https://api.openai.com/v1

# Serper web/image search
BATCHPROMPT_SERPER_API_KEY=your-serper-key

# DataForSEO web search, including structured Google Ads
BATCHPROMPT_DATAFORSEO_LOGIN=your-api-login
BATCHPROMPT_DATAFORSEO_PASSWORD=your-api-password
# Alternatively, provide the Base64 login:password value:
# BATCHPROMPT_DATAFORSEO_AUTH_TOKEN=your-base64-auth-token

BATCHPROMPT_DATAFORSEO_CONCURRENCY=5
